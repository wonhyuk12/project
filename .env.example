# chisung42 프론트를 Supabase 백엔드에 연결하는 데 필요한 값(lib/supabaseData.ts).
# NEXT_PUBLIC_* 대신 EXPO_PUBLIC_* 접두사를 써야 Expo 웹 빌드에 인라인된다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon/publishable key — 브라우저에 노출되는 게 정상(RLS로 보호됨).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 우리 실제 Next.js 백엔드(비밀키가 필요한 /api/compare/advice, /api/youtube/search만
# 크로스 오리진으로 호출) — CORS + Authorization Bearer 인증이 설정돼 있어야 한다.
EXPO_PUBLIC_API_BASE_URL=https://choreohub-api.vercel.app

# (레거시) HTTPS URL of the deployed MediaPipe ingestion service.
# 더 이상 안 씀 — 포즈 추출은 이제 브라우저에서 직접(lib/poseExtract.ts) 한다.
# 남겨둔 이유: uploadForAnalysis()가 남아있는 다른 화면(예: 파일 미리보기)에서 아직 참조함.
EXPO_PUBLIC_MEDIAPIPE_API_URL=http://192.168.0.10:8000
