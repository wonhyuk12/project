# ===================================================================
# .env.example  —  환경변수 '견본' 파일
# -------------------------------------------------------------------
# 실제 값이 아니라 '무엇이 필요한지'만 적어둔 견본입니다.
#
# [로컬(내 PC)에서 실행할 때]
#   1) 이 파일을 복사해 같은 폴더에 .env 라는 이름으로 만듭니다.
#   2) 아래 4개 값을 실제 키로 채웁니다.
#   ※ .env 는 .gitignore 로 제외되어 git(깃허브)에 절대 올라가지 않습니다.
#
# [Render 배포에서 실행할 때]
#   .env 파일을 쓰지 않습니다. Render 대시보드의 Environment 에
#   아래 4개를 '이름=값' 으로 직접 넣습니다. (README 의 배포 절차 참고)
# ===================================================================

# Supabase 프로젝트 주소 (예: https://xxxxxxxx.supabase.co)
SUPABASE_URL=여기에_supabase_프로젝트_URL

# 프론트(로그인)용 공개 키 — 원래 외부에 노출돼도 되는 값
SUPABASE_ANON_KEY=여기에_anon_공개키

# 백엔드 전용 비밀 키 — 절대 외부/프론트로 노출 금지
SUPABASE_SERVICE_KEY=여기에_service_비밀키

# Gemini(AI 글자 인식) 키 — 절대 외부/프론트로 노출 금지
GEMINI_API_KEY=여기에_gemini_키
