# ===========================================================================
# backend/.env.example
# 이 파일을 복사해서 backend/.env 로 만들고 값을 채우세요.
#   cp .env.example .env
# 실제 .env 는 git 에 올라가지 않습니다(.gitignore 처리됨).
# ===========================================================================

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=여기에-임의의-긴-문자열
PORT=5000

# ---- Supabase Postgres 접속 정보 ----
# [방법 A] 연결 문자열 하나로 지정 (Supabase 대시보드 >
#          Project Settings > Database > Connection string > URI 복사)
#   주의: SQLAlchemy 용이므로 접두어를 postgresql+psycopg2:// 로 바꿔주세요.
# DATABASE_URL=postgresql+psycopg2://postgres:비밀번호@db.xxxxxxxx.supabase.co:5432/postgres

# [방법 B] 항목별로 입력 (DATABASE_URL 이 비어 있으면 아래 값들로 조합됩니다)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# ---- (선택) Supabase API 키 — 나중에 필요 시 사용 ----
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ---- CORS 허용 오리진 (프론트 dev 서버 주소, 콤마로 구분) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
